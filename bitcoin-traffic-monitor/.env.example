# Environment Variables Template

# Application Setup
PROJECT_NAME=bitcoin-traffic-monitor
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://btm_user:btm_password@localhost:5432/bitcoin_traffic_monitor
# Alternative SQLite for lightweight local dev:
# DATABASE_URL=sqlite:///./sql_app.db

# Database Credentials (for Docker)
POSTGRES_USER=btm_user
POSTGRES_PASSWORD=btm_password
POSTGRES_DB=bitcoin_traffic_monitor

# GeoLite2 IP Database Path
GEOLITE2_DB_PATH=./data/geolite2/GeoLite2-City.mmdb

# FastAPI Server Config
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
